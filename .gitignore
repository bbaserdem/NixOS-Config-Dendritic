# =============================================================================
# Nix Flake .gitignore
# Comprehensive ignore patterns for nix system configuration development
# =============================================================================

# Git; don't ever ignore these
!/.gitignore
!/.gitattributes

# =============================================================================
# SECRETS & CREDENTIALS (CRITICAL - NEVER COMMIT)
# =============================================================================
.env*
!.env.example
!.env.template
*.pem
*.crt
*.p12
*.pfx
secrets.json
credentials.json

# =============================================================================
# PROJECT CONVENTIONS
# =============================================================================
# No directories or files with prefix _ are to be committed from root
/_*
# Safeguard for agents
!AGENTS.md
# Claude code; ignore local settings file
.claude/settings.local.json
# Codex, ignore full setting (no project/local seperation)
.codex
# Opencode, ignore full setting (no project/local seperation)
.opencode
/opencode.json
# Forgecode, ignore full setting (no project/local seperation)
.forge/.forge.toml
# Droid, user local config
.factory/settings.local.json
# Any bmad stuff
bmad-*
# Git tooling
worktrees
worktrees/**

# =============================================================================
# NIX & DIRENV
# =============================================================================
!/.envrc
.direnv/
result
result-*

# =============================================================================
# DOCUMENTATION
# =============================================================================
/.book

# =============================================================================
# File assets
# =============================================================================
!/assets
!/assets/**

# =============================================================================
# NPM
# =============================================================================
node_modules/
npm-debug.log*
# Logs
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log

# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
# Distribution / packaging
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =============================================================================
# ASSETS
# =============================================================================
# Large media files
*.mkv
*.mp4
*.mov
*.webm

# =============================================================================
# LOGS & TEMPORARY FILES
# =============================================================================
*.log
*.tmp
*.bak
*.swp
*.swo
.tmp/
temp/
tmp/

# =============================================================================
# TOOLS & EDITORS
# =============================================================================
# Vim
*.swp
*.swo
*~
.netrwhist
# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =============================================================================
# OPERATING SYSTEM
# =============================================================================
# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk
# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*
